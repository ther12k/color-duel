# Local tool state and generated output (never part of the repo).
.playwright-cli/
.zcode/
output/
__pycache__/

# Per-artwork content under public/artworks/ is GENERATED by the Arwork
# Studio export pipeline and stays a local concern (hundreds of MB of vector
# JSON, SVG and raster previews per package). Only the catalog index is
# tracked: the game and tests/game-integration's prepare step both append to
# it, and the repository loader skips entries whose package files are absent.
public/artworks/*
!public/artworks/catalog.json
